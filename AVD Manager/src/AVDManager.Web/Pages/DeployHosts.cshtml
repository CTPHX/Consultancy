@page "/DeployHosts"
@model AVDManager.Web.Pages.DeployHostsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Deploy Hosts";
    var firstPool = Model.HostPools.FirstOrDefault();
    var poolData = Model.HostPools.ToDictionary(pool => pool.HostPoolId, pool => new { pool.HostPoolName, pool.Location, pool.ExistingHostCount, pool.SuggestedVmPrefix, pool.AvdResourceGroup, pool.SessionHostResourceGroup, pool.NetworkResourceGroup, pool.GalleryResourceGroup, pool.AutomationResourceGroup, pool.VnetName, pool.SubnetName, pool.GalleryName, pool.ImageDefinition, pool.ImageVersion });
}
<div class="page-heading"><div><span class="eyebrow">SESSION HOST DEPLOYMENT</span><h1>Deploy Hosts</h1><p>Prepare a session host deployment using the environment already discovered by AVD Manager.</p></div></div>
@if (Model.HostPools.Count == 0) { <section class="panel"><div class="empty-state"><strong>No host pools are configured</strong><p>Complete environment discovery before preparing a session host deployment.</p></div></section> }
else
{
    @if (Model.Automation is null) { <section class="panel"><div class="empty-state"><strong>Azure Automation is not configured</strong><p>Select and validate the deployment Automation Account in Settings before deployment submission is enabled.</p><a class="primary-button link-button" href="/Settings">Open Settings</a></div></section> }
    <div class="deploy-grid">
        <section class="panel deploy-form-panel">
            <div class="panel-heading-row"><div><h2>Deployment request</h2><p class="muted">Choose the target and deployment parameters. Submission will be enabled when durable deployment orchestration is connected.</p></div><span class="status-pill status-neutral">Review only</span></div>
            <div class="deploy-fields">
                <label class="deploy-field"><span>Host pool</span><select id="deployHostPool" class="deploy-input">@foreach (var pool in Model.HostPools){<option value="@pool.HostPoolId">@pool.HostPoolName</option>}</select><small>Azure Virtual Desktop host pool to receive the new session hosts.</small></label>
                <label class="deploy-field"><span>VM name prefix</span><input id="vmNamePrefix" class="deploy-input" type="text" maxlength="12" value="@firstPool?.SuggestedVmPrefix" autocomplete="off" /><small>Maximum 12 characters so generated Windows computer names remain valid.</small></label>
                <label class="deploy-field"><span>Number of hosts</span><input id="sessionHostCount" class="deploy-input" type="number" min="1" max="20" value="1" /><small>Number of new session hosts requested for this deployment.</small></label>
                <label class="deploy-toggle"><input id="overwriteExisting" type="checkbox" /><span><strong>Replace existing session hosts</strong><small>Immediately prevents new sessions on existing hosts, then starts the durable grace-period workflow.</small></span></label><div id="replacementOptions" hidden><label class="deploy-field"><span>Grace period</span><select id="gracePeriodHours" class="deploy-input"><option value="0">Immediate</option><option value="1">1 hour</option><option value="2">2 hours</option><option value="3">3 hours</option><option value="4">4 hours</option><option value="5" selected>5 hours</option><option value="6">6 hours</option><option value="8">8 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select><small>Existing hosts remain drained while users are given time to log off.</small></label><label class="deploy-toggle"><input id="forceLogoff" type="checkbox" /><span><strong id="forceLogoffLabel">Force log off remaining users at the end of the grace period</strong><small id="forceLogoffHelp">This policy will be saved with the durable deployment operation.</small></span></label></div>
            </div>
            <div class="deploy-warning" id="overwriteWarning" hidden><strong>Replace existing hosts enabled</strong><span>Existing hosts will not be removed while active sessions remain. Grace period and optional forced logoff will be controlled by the durable AVD Manager deployment operation.</span></div>
            <div class="deploy-actions"><button class="secondary-button" id="reviewDeployment" type="button">Review deployment</button><span class="muted">The first live test will create the durable operation and drain existing hosts only.</span></div><form id="startWorkflowForm" method="post" asp-page-handler="Begin" data-progress-label="Creating deployment workflow…" hidden><input type="hidden" name="HostPoolId" id="postHostPoolId" /><input type="hidden" name="VmNamePrefix" id="postVmNamePrefix" /><input type="hidden" name="SessionHostCount" id="postSessionHostCount" /><input type="hidden" name="VmSize" value="Standard_D2ds_v6" /><input type="hidden" name="GalleryImageVersion" id="postGalleryImageVersion" /><input type="hidden" name="ReplaceExisting" id="postReplaceExisting" value="false" /><input type="hidden" name="GracePeriodHours" id="postGracePeriodHours" /><input type="hidden" name="ForceLogoffAtDeadline" id="postForceLogoff" value="false" /></form>
        </section>
        <section class="panel deploy-summary-panel">
            <div class="panel-heading-row"><div><h2>Discovered environment</h2><p class="muted">Saved Azure relationships for the selected host pool and deployment service.</p></div></div>
            <div class="deploy-summary-list">
                <div><span>Host pool</span><strong id="summaryHostPool">—</strong></div><div><span>Location</span><strong id="summaryLocation">—</strong></div><div><span>Existing hosts</span><strong id="summaryExistingHosts">—</strong></div><div><span>Session host RG</span><strong id="summarySessionHostRg">—</strong></div><div><span>Network</span><strong id="summaryNetwork">—</strong><small id="summaryNetworkRg"></small></div><div><span>Compute Gallery</span><strong id="summaryGallery">—</strong><small id="summaryGalleryRg"></small></div><div><span>Image</span><strong id="summaryImage">—</strong><small id="summaryImageVersion"></small></div>
                <div><span>Automation</span><strong>@(Model.Automation?.AutomationAccountName ?? "Not configured")</strong><small>@(Model.Automation is null ? "Select in Settings" : $"{Model.Automation.ResourceGroupName} · {Model.Automation.DeploymentRunbookName}")</small></div>
            </div>
        </section>
    </div>
    @if (Model.DeploymentDefaultsReadiness.Count > 0)
    {
        <section class="deployment-defaults-readiness">
            @foreach (var pool in Model.HostPools)
            {
                if (!Model.DeploymentDefaultsReadiness.TryGetValue(pool.HostPoolId, out var readiness)) { continue; }
                @if (!readiness.IsConfigured)
                {
                    <article class="deployment-message deployment-message-warning permission-readiness-card" data-defaults-host-pool="@pool.HostPoolId" hidden>
                        <strong>Advanced deployment defaults incomplete — @pool.HostPoolName</strong>
                        <span>Configure this host pool in Settings before submitting a deployment.</span>
                        @if (readiness.MissingFields.Count > 0)
                        {
                            <small>Missing: @string.Join(", ", readiness.MissingFields)</small>
                        }
                        <a class="secondary-button link-button" href="/Settings#advanced-deployment-defaults">Open deployment defaults</a>
                    </article>
                }
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="deployment-message deployment-message-good">@Model.StatusMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="deployment-message deployment-message-error">@Model.ErrorMessage</div> }

    @if (Model.VisibleOperations.Count > 0)
    {
        var liveStatuses = new[] { "Starting", "Draining", "WaitingForSessions", "ReadyForAutomation", "Submitted", "Queued", "Running" };
        var liveOperations = Model.VisibleOperations
            .Where(operation => liveStatuses.Contains(operation.Status, StringComparer.OrdinalIgnoreCase))
            .ToList();
        var pastOperations = Model.VisibleOperations
            .Where(operation => !liveStatuses.Contains(operation.Status, StringComparer.OrdinalIgnoreCase))
            .ToList();
        var operationGroups = new[]
        {
            new { Title = "Live deployments", Description = "Deployments currently being prepared, drained or processed.", Operations = liveOperations },
            new { Title = "Past deployments", Description = "The latest completed, cancelled or failed deployment operations.", Operations = pastOperations }
        };

        <div class="deployment-operations">
            <div class="operations-heading">
                <div><span class="eyebrow">DEPLOYMENT OPERATIONS</span><h2>Deployments</h2><p class="muted">Each host pool runs as an independent durable deployment operation.</p></div>
            </div>

            @foreach (var group in operationGroups)
            {
                if (group.Operations.Count == 0) { continue; }

                <section class="deployment-operation-group">
                    <div class="operation-group-heading">
                        <h3>@group.Title</h3>
                        <p class="muted">@group.Description</p>
                    </div>

                    @foreach (var operation in group.Operations)
                    {
                        var active = liveStatuses.Contains(operation.Status, StringComparer.OrdinalIgnoreCase);
                        var waiting = operation.Status.Equals("WaitingForSessions", StringComparison.OrdinalIgnoreCase);
                        var good = operation.Status.Equals("ReadyForAutomation", StringComparison.OrdinalIgnoreCase) ||
                                   operation.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase);
                        var failed = operation.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase);
                        var cancelled = operation.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                        <article class="panel deployment-operation-card">
                            <div class="operation-card-heading">
                                <div><span class="eyebrow">HOST POOL</span><h3>@operation.HostPoolName</h3><p class="muted">@operation.VmNamePrefix · @operation.SessionHostCount host(s)</p></div>
                                <span class="status-pill @(good ? "status-good" : failed ? "status-bad" : active ? "status-neutral" : "status-neutral")">@operation.Status@if (!string.IsNullOrWhiteSpace(operation.AutomationJobId) && active){<span class="deployment-elapsed" data-started="@operation.UpdatedAtUtc.ToString("O")"></span>}</span>
                            </div>
                            <div class="operation-detail-grid">
                                <div><span>Current stage</span><strong>@operation.Status</strong></div>
                                <div><span>Sessions remaining</span><strong>@operation.ActiveSessionCount</strong></div>
                                <div><span>Replacement</span><strong>@(operation.ReplaceExisting ? "Yes" : "No")</strong></div>
                                <div><span>Grace period</span><strong>@(operation.ReplaceExisting ? (operation.GracePeriodHours == 0 ? "Immediate" : $"{operation.GracePeriodHours} hour(s)") : "Not applicable")</strong>@if (waiting && operation.GraceDeadlineUtc is not null){<small class="grace-countdown" data-deadline="@operation.GraceDeadlineUtc.Value.ToString("O")">Calculating…</small>}</div>
                                <div><span>Forced logoff</span><strong>@(operation.ForceLogoffAtDeadline ? "Enabled" : "Disabled")</strong></div>
                                <div><span>Updated</span><strong>@operation.UpdatedAtUtc.ToLocalTime().ToString("g")</strong></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(operation.LastMessage)) { <p class="operation-last-message">@operation.LastMessage</p> }
                            @if (!string.IsNullOrWhiteSpace(operation.ErrorMessage)) { <p class="operation-error">@operation.ErrorMessage</p> }
                            @if (!string.IsNullOrWhiteSpace(operation.AutomationJobId))
                            {
                                <div class="automation-job-meta">
                                    <span>Azure Automation job</span>
                                    <strong>@operation.AutomationJobId</strong>
                                    <small class="muted">Status: @(operation.AutomationJobStatus ?? operation.Status) · Output refreshes with the deployment monitor.</small>
                                </div>
                                <details class="automation-output" @(active ? "open" : null)>
                                    <summary>Runbook output (@(operation.AutomationOutput?.Count ?? 0))</summary>
                                    <div class="automation-output-lines">
                                        @if (operation.AutomationOutput is { Count: > 0 })
                                        {
                                            @foreach (var line in operation.AutomationOutput)
                                            {
                                                <div class="automation-output-line">
                                                    @if (line.TimeUtc is not null) { <time>@line.TimeUtc.Value.ToLocalTime().ToString("HH:mm:ss")</time> }
                                                    <pre>@line.Text</pre>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="muted">No Output stream entries have been returned by Azure Automation yet.</p>
                                        }
                                    </div>
                                </details>
                            }
                            <div class="operation-actions">
                                @if (waiting)
                                {
                                    <form method="post" asp-page-handler="CheckSessions" data-progress-label="Checking user sessions…"><input type="hidden" name="operationId" value="@operation.Id" /><button class="secondary-button" type="submit">Check now</button></form>
                                }
                                @if (active && string.IsNullOrWhiteSpace(operation.AutomationJobId))
                                {
                                    if (!operation.ReplaceExisting || operation.OriginalHostStates is { Count: > 0 })
                                    {
                                        <form method="post" asp-page-handler="Cancel" data-progress-label="Cancelling deployment…"><input type="hidden" name="operationId" value="@operation.Id" /><button class="secondary-button danger-button" type="submit">Cancel deployment</button></form>
                                        <small class="muted">Cancellation is available until the Azure Automation deployment job is submitted.</small>
                                    }
                                    else
                                    {
                                        <small class="muted">Legacy test operation: original drain state was not captured, so automatic cancellation is disabled.</small>
                                    }
                                }
                                else if (cancelled) { <small class="muted">Deployment cancelled. Original session-host drain states were restored.</small> }
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    }

    <section class="panel deployment-review" id="deploymentReview" hidden><div class="panel-heading-row"><div><h2>Deployment review</h2><p class="muted">Request that will be handed to the durable deployment workflow.</p></div><span class="status-pill status-good">Ready for orchestration</span></div><div class="deployment-review-grid"><div><span>Target</span><strong id="reviewHostPool">—</strong></div><div><span>VM prefix</span><strong id="reviewPrefix">—</strong></div><div><span>Hosts requested</span><strong id="reviewCount">—</strong></div><div><span>Replace existing</span><strong id="reviewOverwrite">—</strong></div></div></section>
}
<style>.deploy-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr);gap:16px}.deploy-fields{display:grid;gap:16px;margin-top:18px}.deploy-field{display:grid;gap:7px}.deploy-field>span,.deploy-summary-list span,.deployment-review-grid span{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.deploy-input{width:100%;box-sizing:border-box;background:var(--surface-2,#0d1a24);color:var(--text);border:1px solid var(--border);border-radius:8px;padding:11px 12px;font:inherit}.deploy-toggle{display:flex;align-items:flex-start;gap:10px;padding:13px;border:1px solid var(--border);border-radius:8px}.deploy-toggle span{display:grid;gap:4px}.deploy-warning{margin-top:16px;padding:13px;border:1px solid #9a6b24;border-radius:8px;background:rgba(154,107,36,.12);display:grid;gap:5px}.deploy-warning[hidden]{display:none}.deploy-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:18px}.deploy-summary-list{display:grid;margin-top:10px}.deploy-summary-list>div{display:grid;gap:3px;padding:11px 0;border-bottom:1px solid var(--border)}.deployment-review{margin-top:16px}.deployment-review-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:16px}.deployment-review-grid>div{display:grid;gap:5px;padding:13px;border:1px solid var(--border);border-radius:8px}@@media(max-width:1050px){.deploy-grid{grid-template-columns:1fr}.deployment-review-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:650px){.deployment-review-grid{grid-template-columns:1fr}} .deployment-operations{display:grid;gap:20px;margin-top:18px}.operations-heading{margin-bottom:2px}.deployment-operation-group{display:grid;gap:12px}.operation-group-heading{padding-top:2px}.operation-group-heading h3{margin:0 0 4px;font-size:18px}.operation-group-heading p{margin:0}.deployment-operation-card{display:grid;gap:14px}.operation-card-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.operation-card-heading h3{margin:3px 0}.operation-detail-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.operation-detail-grid>div{display:grid;gap:4px;padding:11px;border:1px solid var(--border);border-radius:8px}.operation-detail-grid span{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.operation-last-message{margin:0}.operation-error{margin:0;color:#ff8b8b}.automation-job-meta{display:grid;gap:4px;padding:11px 12px;border:1px solid var(--border);border-radius:8px}.automation-job-meta>span{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.automation-job-meta strong{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.86rem;overflow-wrap:anywhere}.automation-output{border:1px solid var(--border);border-radius:8px;overflow:hidden}.automation-output summary{cursor:pointer;padding:11px 12px;font-weight:700}.automation-output-lines{max-height:360px;overflow:auto;border-top:1px solid var(--border);padding:8px 12px;background:#0b151d}.automation-output-line{display:grid;grid-template-columns:72px minmax(0,1fr);gap:10px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.05)}.automation-output-line:last-child{border-bottom:0}.automation-output-line time{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.76rem;padding-top:2px}.automation-output-line pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;color:#dce8f2;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.8rem}html[data-theme="light"] .automation-output-lines{background:#f5f8fa}html[data-theme="light"] .automation-output-line pre{color:#172532}.operation-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.operation-actions form{margin:0}.danger-button{border-color:#a94b4b}.deployment-message{margin:16px 0;padding:12px 14px;border:1px solid var(--border);border-radius:8px}.deployment-message-good{border-color:#24885b}.deployment-message-error{border-color:#a94b4b}.deployment-message-warning{border-color:#9a6b24}.permission-readiness-card{display:grid;gap:5px}.permission-readiness-card[hidden]{display:none}@@media(max-width:1100px){.operation-detail-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@@media(max-width:650px){.operation-detail-grid{grid-template-columns:1fr}} </style>
@section Scripts {<script>(()=>{const pools=@Html.Raw(JsonSerializer.Serialize(poolData));const hp=document.getElementById('deployHostPool');if(!hp)return;const prefix=document.getElementById('vmNamePrefix'),count=document.getElementById('sessionHostCount'),overwrite=document.getElementById('overwriteExisting'),warning=document.getElementById('overwriteWarning'),review=document.getElementById('deploymentReview'),grace=document.getElementById('gracePeriodHours');const text=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v||'—'};const selected=()=>pools[hp.value];function refresh(reset=false){const p=selected();if(!p)return;document.querySelectorAll('[data-defaults-host-pool]').forEach(el=>el.hidden=el.dataset.defaultsHostPool!==hp.value);if(reset)prefix.value=p.SuggestedVmPrefix||'';text('summaryHostPool',p.HostPoolName);text('summaryLocation',p.Location);text('summaryExistingHosts',String(p.ExistingHostCount));text('summarySessionHostRg',p.SessionHostResourceGroup);text('summaryNetwork',[p.VnetName,p.SubnetName].filter(Boolean).join(' / '));text('summaryNetworkRg',p.NetworkResourceGroup);text('summaryGallery',p.GalleryName);text('summaryGalleryRg',p.GalleryResourceGroup);text('summaryImage',p.ImageDefinition);text('summaryImageVersion',p.ImageVersion?`Version ${p.ImageVersion}`:'Image version unavailable');review.hidden=true}hp.addEventListener('change',()=>refresh(true));overwrite.addEventListener('change',()=>{warning.hidden=!overwrite.checked;const o=document.getElementById('replacementOptions');if(o)o.hidden=!overwrite.checked;review.hidden=true});prefix.addEventListener('input',()=>review.hidden=true);count.addEventListener('input',()=>review.hidden=true);const refreshGrace=()=>{const immediate=grace?.value==='0';text('forceLogoffLabel',immediate?'Force log off remaining users immediately':'Force log off remaining users at the end of the grace period');text('forceLogoffHelp',immediate?'If enabled, remaining sessions will be eligible for immediate forced logoff when the workflow reaches that stage.':'This policy will be saved with the durable deployment operation.');review.hidden=true};grace?.addEventListener('change',refreshGrace);refreshGrace();document.getElementById('reviewDeployment')?.addEventListener('click',()=>{const p=selected(),n=Number.parseInt(count.value,10),v=prefix.value.trim();if(!p)return;if(!v||v.length>12){prefix.focus();return}if(!Number.isInteger(n)||n<1||n>20){count.focus();return}text('reviewHostPool',p.HostPoolName);text('reviewPrefix',v);text('reviewCount',String(n));text('reviewOverwrite',overwrite.checked?'Yes — durable drain/grace workflow required':'No');review.hidden=false;let start=document.getElementById('startWorkflow');if(!start){start=document.createElement('button');start.id='startWorkflow';start.type='button';start.className='primary-button';start.textContent='Start workflow';review.querySelector('.panel-heading-row').appendChild(start);start.addEventListener('click',()=>{document.getElementById('postHostPoolId').value=hp.value;document.getElementById('postVmNamePrefix').value=prefix.value.trim();document.getElementById('postSessionHostCount').value=count.value;document.getElementById('postGalleryImageVersion').value=selected().ImageVersion||'Latest';document.getElementById('postReplaceExisting').value=overwrite.checked?'true':'false';document.getElementById('postGracePeriodHours').value=document.getElementById('gracePeriodHours').value;document.getElementById('postForceLogoff').value=document.getElementById('forceLogoff').checked?'true':'false';document.getElementById('startWorkflowForm').submit()})}review.scrollIntoView({behavior:'smooth',block:'nearest'})});refresh(false);const elapsed=[...document.querySelectorAll('.deployment-elapsed')];const updateElapsed=()=>{const now=Date.now();for(const el of elapsed){const started=Date.parse(el.dataset.started);if(!Number.isFinite(started))continue;const total=Math.max(0,Math.floor((now-started)/1000)),hours=Math.floor(total/3600),minutes=Math.floor((total%3600)/60),seconds=total%60;el.textContent=' · '+String(hours).padStart(2,'0')+':'+String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0')}};updateElapsed();if(elapsed.length)setInterval(updateElapsed,1000);const countdowns=[...document.querySelectorAll('.grace-countdown')];const updateCountdowns=()=>{const now=Date.now();for(const el of countdowns){const deadline=Date.parse(el.dataset.deadline);if(!Number.isFinite(deadline)){el.textContent='Deadline unavailable';continue}let ms=deadline-now;if(ms<=0){el.textContent='Grace period expired';continue}const total=Math.floor(ms/1000),days=Math.floor(total/86400),hours=Math.floor((total%86400)/3600),minutes=Math.floor((total%3600)/60),seconds=total%60;el.textContent='Time remaining: '+(days?days+'d ':'')+String(hours).padStart(2,'0')+':'+String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0')}};updateCountdowns();if(countdowns.length)setInterval(updateCountdowns,1000)})();</script>}
