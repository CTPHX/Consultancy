@page
@model AVDManager.Web.Pages.ImageManagementModel
@{
    ViewData["Title"] = "Image Management";
}
<div class="page-heading"><div><h1>Image Management</h1><p>Build a new Azure Compute Gallery image version from a selected gold image VM.</p></div></div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="panel"><p class="status-bad">@Model.ErrorMessage</p></div> }
@if (Model.Environment is null) { <div class="panel"><p class="muted">Configure an Azure environment before building images.</p></div> }
else if (Model.Discovery is not null)
{
<div class="deploy-grid">
<article class="panel">
    <span class="eyebrow">IMAGE BUILD REQUEST</span>
    <h2>Build gold image</h2>
    <p class="muted">Choose the source gold VM and the gallery definition that will receive the captured image.</p>
    <form method="post" id="imageBuildForm" asp-page-handler="Review">
        <label class="field-label">Gold image VM</label>
        <select asp-for="Build.GoldVmId" id="goldVm" required>
            <option value="">Select a gold image VM</option>
            @foreach (var vm in Model.Discovery.VirtualMachines) { <option value="@vm.Id" data-location="@vm.Location" data-rg="@vm.ResourceGroup">@vm.Name</option> }
        </select>

        <label class="field-label">Target Compute Gallery</label>
        <select asp-for="Build.GalleryId" id="gallery" required>
            <option value="">Select a gallery</option>
            @foreach (var g in Model.Discovery.Galleries) { <option value="@g.Id" data-name="@g.Name" data-rg="@g.ResourceGroup">@g.Name</option> }
        </select>

        <label class="field-label">Image definition</label>
        <select asp-for="Build.ImageDefinitionId" id="definition" required>
            <option value="">Select an image definition</option>
            @foreach (var d in Model.Discovery.Definitions) { <option value="@d.Id" data-gallery="@d.GalleryName" data-name="@d.Name" data-id="@d.Id">@d.Name</option> }
        </select>

        <div class="image-version-summary">
            <div><span class="eyebrow">CURRENT LATEST</span><strong id="currentVersion">—</strong></div>
            <div><span class="eyebrow">PROPOSED VERSION</span><strong id="proposedVersion">—</strong></div>
        </div>
        <label class="field-label">New image version</label>
        <input asp-for="Build.ImageVersion" id="imageVersion" placeholder="0.0.1" required />

        <label class="field-label">Temporary VM network</label>
        <select asp-for="Build.VirtualNetworkId" id="vnet" required>
            <option value="">Select a virtual network</option>
            @foreach (var v in Model.Discovery.VirtualNetworks) { <option value="@v.Id">@v.Name</option> }
        </select>
        <label class="field-label">Subnet</label>
        <select asp-for="Build.SubnetName" id="subnet" data-default="@Model.Build.SubnetName" required>
            <option value="">Select a subnet</option>
        </select>

        <details class="image-advanced"><summary>Advanced build options</summary>
            <label class="field-label">Temporary VM size</label><select asp-for="Build.TempVmSize">@foreach (var size in Model.VmSizes) { <option value="@size">@size</option> }</select>
            <label class="field-label">Replica count</label><input asp-for="Build.ReplicaCount" type="number" min="1" max="10" />
            <label class="field-label">Target regions</label><select asp-for="Build.TargetRegions" multiple size="6" class="multi-select">@foreach (var region in Model.Regions) { <option value="@region.Name">@region.DisplayName (@region.Name)</option> }</select><small class="muted">Select one or more replication regions. Ctrl/Cmd-click to select multiple.</small>
            <label class="image-checkbox-card"><input asp-for="Build.ExcludeFromLatest" /><span><b>Exclude from latest</b><small>Do not return this version when consumers request latest.</small></span></label>
        </details>

        <div class="notice"><b>Review before building</b><br />No Azure resources will be changed at this stage. Review the resolved build request before automation is enabled.</div>
        <button type="submit" class="primary-button">Review image build</button>
    </form>
</article>
<article class="panel">
@if (Model.Review is not null)
{
    <span class="eyebrow">IMAGE BUILD REVIEW</span><h2>Ready for review</h2>
    <p class="muted">Confirm the resolved values below. No Azure changes have been made.</p>
    <div class="review-grid">
        <div><span>Gold image VM</span><strong>@Model.Review.GoldVmName</strong></div>
        <div><span>Target gallery</span><strong>@Model.Review.GalleryName</strong></div>
        <div><span>Image definition</span><strong>@Model.Review.DefinitionName</strong></div>
        <div><span>New version</span><strong>@Model.Review.ImageVersion</strong></div>
        <div><span>Virtual network</span><strong>@Model.Review.VirtualNetworkName</strong></div>
        <div><span>Subnet</span><strong>@Model.Review.SubnetName</strong></div>
        <div><span>Temporary VM size</span><strong>@Model.Review.TempVmSize</strong></div>
        <div><span>Replica count</span><strong>@Model.Review.ReplicaCount</strong></div>
        <div class="review-wide"><span>Target regions</span><strong>@string.Join(", ", Model.Review.TargetRegions)</strong></div>
        <div class="review-wide"><span>Latest behaviour</span><strong>@(Model.Review.ExcludeFromLatest ? "Excluded from latest" : "Included in latest")</strong></div>
    </div>
    <div class="notice warning"><b>Ready to submit</b><br />Building will create temporary Azure resources, sysprep the cloned VM and publish version <strong>@Model.Review.ImageVersion</strong> to the selected Compute Gallery definition.</div>
    <form method="post" asp-page-handler="Build" onsubmit="return confirm('Start this gold image build? Azure resources will now be created and the selected image version will be published.');">
        <input type="hidden" asp-for="Build.GoldVmId" /><input type="hidden" asp-for="Build.GalleryId" />
        <input type="hidden" asp-for="Build.ImageDefinitionId" /><input type="hidden" asp-for="Build.ImageVersion" />
        <input type="hidden" asp-for="Build.VirtualNetworkId" /><input type="hidden" asp-for="Build.SubnetName" />
        <input type="hidden" asp-for="Build.TempVmSize" /><input type="hidden" asp-for="Build.ReplicaCount" />
        @foreach (var region in Model.Build.TargetRegions) { <input type="hidden" name="Build.TargetRegions" value="@region" /> }
        <input type="hidden" name="Build.ExcludeFromLatest" value="@Model.Build.ExcludeFromLatest.ToString().ToLowerInvariant()" />
        <button type="submit" class="primary-button">Build image</button>
    </form>
}
else
{
    <span class="eyebrow">DISCOVERED IMAGE ESTATE</span><h2>Azure Compute Gallery</h2>
    <p class="muted">@Model.Discovery.Galleries.Count gallery(s) · @Model.Discovery.Definitions.Count definition(s) · @Model.Discovery.Versions.Count version(s)</p>
    @foreach (var g in Model.Discovery.Galleries) {
      <div class="setting-row"><span><b>@g.Name</b><small>@g.ResourceGroup · @g.Location</small></span></div>
    }
}

    @if (Model.Operations.Count > 0)
    {
        <div class="image-operations">
            <span class="eyebrow">IMAGE BUILD ACTIVITY</span>
            @foreach (var op in Model.Operations.Take(5))
            {
                <div class="image-operation">
                    <div><strong>@op.DefinitionName @op.ImageVersion</strong><small>@op.GoldVmName · @op.UpdatedAtUtc.ToLocalTime().ToString("g")</small></div>
                    <div><strong>@op.Status</strong><small>@(op.ErrorMessage ?? op.LastMessage)</small></div>
                </div>
            }
        </div>
    }
</article>
</div>
<script type="application/json" id="imageVersions">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Discovery.Versions.Select(v => new { GalleryName = v.GalleryName, DefinitionName = v.DefinitionName, Name = v.Name, Id = v.Id })))</script>
}
@section Scripts {
<script>
(() => {
 const gallery=document.getElementById('gallery'), definition=document.getElementById('definition'), version=document.getElementById('imageVersion');
 const vnet=document.getElementById('vnet'), subnet=document.getElementById('subnet');
 if(!gallery||!definition) return;
 const versions=JSON.parse(document.getElementById('imageVersions').textContent);
 function refreshDefinitions(){
   const name=gallery.selectedOptions[0]?.dataset.name||'';
   [...definition.options].forEach((o,i)=>{ if(i) o.hidden=o.dataset.gallery!==name; });
   if(definition.selectedOptions[0]?.hidden) definition.value='';
   refreshVersion();
 }
 function refreshVersion(){
   const g=gallery.selectedOptions[0]?.dataset.name||'', d=definition.selectedOptions[0]?.dataset.name||'';
   const definitionId=(definition.selectedOptions[0]?.dataset.id||definition.value||'').replace(/\/$/,'').toLowerCase();
   const matches=versions.filter(x=>{
     const versionId=(x.Id??x.id??'').toLowerCase();
     if(definitionId && versionId.startsWith(definitionId + '/versions/')) return true;
     return String(x.GalleryName??x.galleryName??'').toLowerCase()===g.toLowerCase() &&
            String(x.DefinitionName??x.definitionName??'').toLowerCase()===d.toLowerCase();
   }).map(x=>x.Name??x.name);
   matches.sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));
   const latest=matches.length?matches[matches.length-1]:null;
   document.getElementById('currentVersion').textContent=latest||'No versions';
   let next='0.0.1';
   if(latest){ const p=latest.split('.').map(Number); next=[p[0]||0,p[1]||0,(p[2]||0)+1].join('.'); }
   document.getElementById('proposedVersion').textContent=next; version.value=next;
 }
 async function refreshSubnets(){
   if(!vnet||!subnet) return;
   const wanted=subnet.dataset.default||subnet.value;
   subnet.innerHTML='<option value="">Loading subnets…</option>';
   if(!vnet.value){ subnet.innerHTML='<option value="">Select a subnet</option>'; return; }
   try{
     const r=await fetch('?handler=Subnets&vnetId='+encodeURIComponent(vnet.value));
     const items=await r.json();
     subnet.innerHTML='<option value="">Select a subnet</option>';
     items.forEach(x=>{ const o=document.createElement('option'); o.value=x.name??x.Name; o.textContent=x.name??x.Name; subnet.appendChild(o); });
     if(wanted && [...subnet.options].some(o=>o.value===wanted)) subnet.value=wanted;
     subnet.dataset.default='';
   }catch{ subnet.innerHTML='<option value="">Could not load subnets</option>'; }
 }
 gallery.addEventListener('change',refreshDefinitions); definition.addEventListener('change',refreshVersion);
 if(vnet) vnet.addEventListener('change',()=>{ if(subnet) subnet.dataset.default=''; refreshSubnets(); });
 refreshDefinitions(); refreshSubnets();
})();
</script>
}
<style>
.deploy-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:14px}.deploy-grid .panel{min-height:auto}.deploy-grid form{display:grid;gap:8px}.deploy-grid select,.deploy-grid input{width:100%;padding:11px;border:1px solid var(--border);border-radius:7px;background:var(--surface2);color:var(--text)}.field-label{margin-top:8px;font-size:11px;color:var(--muted);text-transform:uppercase}.image-version-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.image-version-summary>div{padding:12px;border:1px solid var(--border);border-radius:7px}.image-version-summary strong{display:block;margin-top:5px}.image-advanced{margin:12px 0;padding:12px;border:1px solid var(--border);border-radius:7px}.image-advanced summary{cursor:pointer;font-weight:700}.multi-select{min-height:130px}.image-checkbox-card{display:flex;align-items:flex-start;gap:12px;margin-top:12px;padding:13px 14px;border:1px solid var(--border);border-radius:7px;cursor:pointer}.image-checkbox-card input{width:auto!important;margin:3px 0 0;flex:0 0 auto}.image-checkbox-card span{display:flex;flex-direction:column;gap:3px}.image-checkbox-card b{line-height:1.3}.image-checkbox-card small{color:var(--muted);line-height:1.4}.notice{padding:12px;border:1px solid var(--border);border-radius:7px;margin:8px 0}.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.review-grid>div{padding:12px;border:1px solid var(--border);border-radius:7px;min-width:0}.review-grid span{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:5px}.review-grid strong{display:block;word-break:break-word}.review-wide{grid-column:1/-1}.image-debug{margin-top:16px;padding-top:12px;border-top:1px solid var(--border)}.image-debug summary{cursor:pointer;font-weight:700}.image-debug-item{margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:7px}.image-debug-item>div{display:grid;grid-template-columns:90px 1fr;gap:8px;margin:5px 0}.image-debug-item span{font-size:11px;color:var(--muted);text-transform:uppercase}.image-debug-item code{white-space:normal;word-break:break-all;font-size:11px}.image-operations{margin-top:20px;padding-top:16px;border-top:1px solid var(--border)}.image-operation{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:12px;padding:11px 0;border-bottom:1px solid var(--border)}.image-operation small{display:block;color:var(--muted);margin-top:3px}@@media(max-width:900px){.deploy-grid{grid-template-columns:1fr}}
</style>
