@using AVDManager.Web.Services
@inject EnvironmentConfigurationStore EnvironmentStore
@{
    var savedEnvironment = await EnvironmentStore.GetAsync(Context.RequestAborted);
    var environmentLabel = savedEnvironment?.SubscriptionName ?? "No environment selected";
    var lastScan = savedEnvironment?.LastScannedAtUtc.ToLocalTime().ToString("g") ?? "Not scanned";
    var topStatusMessage = ViewData["TopStatusMessage"] as string;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AVD Manager</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><div class="brand-mark">A</div><div><b>AVD Manager</b><small>By Phoenix Software</small></div></div>
        <nav>
            <a href="/">Dashboard</a><a href="/SessionHosts">Host Pools</a><a href="#">Deploy Hosts</a><a href="#">Image Management</a><a href="#">FSLogix Profiles</a><a href="#">Storage Management</a><a href="#">Automation Jobs</a><a href="#">Schedules</a><a href="#">Reports</a><a href="#">Audit Log</a><a href="/Settings">Settings</a>
        </nav>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <span class="environment">@environmentLabel</span>
            <div class="top-actions">
                @if (!string.IsNullOrWhiteSpace(topStatusMessage))
                {
                    <span class="top-status-message status-good">@topStatusMessage</span>
                }
                <div class="info-menu">
                    <button id="infoToggle" class="icon-button" type="button" title="Environment information" aria-label="Environment information" aria-expanded="false">ⓘ</button>
                    <aside id="infoPanel" class="info-panel" hidden>
                        <div class="info-panel-heading"><div><span class="eyebrow">AVD MANAGER</span><h3>Information</h3></div><button id="infoClose" class="info-close" type="button" aria-label="Close information">×</button></div>
                        @if (savedEnvironment is not null)
                        {
                            <div class="info-section"><span>Subscription</span><strong>@savedEnvironment.SubscriptionName</strong><small class="info-mono">@savedEnvironment.SubscriptionId</small></div>
                            <div class="info-section"><span>Last environment scan</span><strong>@lastScan</strong><small>Use the relevant re-scan controls to reconcile current Azure state.</small></div>
                        }
                        else
                        {
                            <div class="info-section"><span>Subscription</span><strong>Not configured</strong><small>Complete onboarding to configure an Azure subscription.</small></div>
                        }
                    </aside>
                </div>
                <button id="themeToggle" class="icon-button" type="button" title="Switch theme">☾</button>
                <span>AVD Manager</span>
            </div>
        </header>
        <main>@RenderBody()</main>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
