@page
@model AVDManager.Web.Pages.SessionHostsModel
@{
    ViewData["Title"] = "Host Pools";
    var totalHosts = Model.SessionHosts.Count;
    var available = Model.SessionHosts.Count(h => string.Equals(h.Status, "Available", StringComparison.OrdinalIgnoreCase));
    var unavailable = totalHosts - available;
    var sessions = Model.SessionHosts.Sum(h => h.Sessions);
}

<div class="page-heading">
    <div>
        <h1>Host Pools</h1>
        <p>@Model.EnvironmentConfiguration!.SubscriptionName · Azure Virtual Desktop host pools and registered session hosts</p>
    </div>
    <a class="secondary-button link-button" href="/Settings">Re-scan environment</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-message status-bad" style="margin-bottom: 16px;">@Model.ErrorMessage</div>
}

<section class="metrics session-host-metrics">
    <article class="metric"><span>Host Pools</span><strong>@Model.HostPools.Count</strong><small>Configured</small></article>
    <article class="metric"><span>Session Hosts</span><strong>@totalHosts</strong><small>Registered</small></article>
    <article class="metric"><span>Available</span><strong>@available</strong><small>@unavailable unavailable</small></article>
    <article class="metric"><span>Active Sessions</span><strong>@sessions</strong><small>Across all host pools</small></article>
</section>

<div class="panel-heading-row" style="margin-bottom: 14px;">
    <div><h2>Host pools</h2><p class="muted">Session hosts are grouped by their Azure Virtual Desktop host pool.</p></div>
    <div style="text-align:right;">
        <span class="status-pill status-good" id="liveStatus">Live · 30s</span>
        <span class="last-scan" style="display:block; margin-top:6px;">Environment scan @Model.EnvironmentConfiguration.LastScannedAtUtc.ToLocalTime().ToString("g")</span>
    </div>
</div>

@if (Model.HostPools.Count == 0)
{
    <section class="panel"><div class="empty-state"><strong>No host pools discovered</strong><p>Re-scan Azure after creating or assigning an Azure Virtual Desktop host pool.</p></div></section>
}
else
{
    @foreach (var pool in Model.HostPools)
    {
        var showManualRescanMessage = !string.IsNullOrWhiteSpace(Model.ManualRescanMessage) &&
                                      string.Equals(Model.ManualRescanHostPoolId, pool.HostPoolId, StringComparison.OrdinalIgnoreCase);

        <section class="panel session-host-panel" style="margin-bottom: 16px;" data-host-pool-id="@pool.HostPoolId">
            <div class="panel-heading-row">
                <div>
                    @if (showManualRescanMessage)
                    {
                        <div style="margin-bottom:8px;"><span class="status-pill status-good">@Model.ManualRescanMessage</span></div>
                    }
                    <h2>@pool.HostPoolName</h2>
                    <p class="muted">@pool.HostPoolLocation · @pool.SessionHosts.Count session host(s) · @pool.AvailableHosts available · @pool.ActiveSessions active session(s)</p>
                    <small class="last-scan">Last scanned @pool.LastScannedAtUtc.ToLocalTime().ToString("g")</small>
                </div>
                <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; justify-content:flex-end;">
                    @if (pool.UnavailableHosts > 0)
                    {
                        <span class="status-pill status-bad">@pool.UnavailableHosts unavailable</span>
                    }
                    else if (pool.SessionHosts.Count > 0)
                    {
                        <span class="status-pill status-good">Healthy</span>
                    }
                    else
                    {
                        <span class="status-pill status-neutral">No hosts</span>
                    }
                    <a asp-page="/HostPool" asp-route-id="@pool.HostPoolName" class="secondary-button link-button">More details</a>
                    <form method="post" asp-page-handler="RescanHostPool" class="host-pool-rescan-form">
                        <input type="hidden" name="hostPoolId" value="@pool.HostPoolId" />
                        <input type="hidden" name="automatic" value="false" />
                        <button class="secondary-button host-pool-rescan-button" type="submit">Re-scan host pool</button>
                    </form>
                </div>
            </div>

            @if (pool.SessionHosts.Count == 0)
            {
                <div class="empty-state"><strong>No registered session hosts</strong><p>This host pool currently has no session hosts in the saved Azure discovery scan.</p></div>
            }
            else
            {
                <div class="session-host-table-wrap">
                    <table class="session-host-table">
                        <thead><tr><th>Session host</th><th>Status</th><th>Drain mode</th><th>Sessions</th><th>VM</th><th>Network</th><th>Image</th></tr></thead>
                        <tbody>
                        @foreach (var host in pool.SessionHosts)
                        {
                            var isAvailable = string.Equals(host.Status, "Available", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td><strong>@host.Name</strong></td>
                                <td><span class="status-pill @(isAvailable ? "status-good" : "status-bad")">@(host.Status ?? "Unknown")</span></td>
                                <td><span class="status-pill @(host.AllowNewSession == false ? "status-warn" : "status-neutral")">@(host.AllowNewSession == false ? "On" : "Off")</span></td>
                                <td><strong>@host.Sessions</strong></td>
                                <td><strong>@(host.VmName ?? "—")</strong><small>@(host.VmResourceGroup ?? "VM relationship unavailable")</small></td>
                                <td><strong>@(host.VnetName ?? "—")</strong><small>@(host.SubnetName ?? host.NicName ?? "Network relationship unavailable")</small></td>
                                <td><strong>@(host.ImageDefinition ?? "—")</strong><small>@(host.ImageVersion is null ? host.GalleryName ?? "Image relationship unavailable" : $"{host.ImageVersion} · {host.GalleryName}")</small></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

<p class="mapping-note">This page checks Azure Virtual Desktop every 30 seconds while it is open. If a host is added, removed, changes availability, drain mode or session count, AVD Manager automatically refreshes the affected host pool. The Re-scan host pool button forces an immediate targeted refresh. Use Settings to re-scan the whole Azure environment when host pools or other environment resources are added or removed.</p>

<script>
(() => {
    const intervalMs = 30000;
    const liveStatus = document.getElementById('liveStatus');
    let checking = false;

    async function checkHostPools() {
        if (checking || document.hidden) return;
        checking = true;
        if (liveStatus) liveStatus.textContent = 'Checking Azure…';

        try {
            const panels = Array.from(document.querySelectorAll('[data-host-pool-id]'));
            for (const panel of panels) {
                const hostPoolId = panel.dataset.hostPoolId;
                const url = `?handler=LiveStatus&hostPoolId=${encodeURIComponent(hostPoolId)}`;
                const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
                if (!response.ok) continue;

                const result = await response.json();
                if (result.changed) {
                    const form = panel.querySelector('.host-pool-rescan-form');
                    const button = panel.querySelector('.host-pool-rescan-button');
                    if (button) {
                        button.disabled = true;
                        button.textContent = 'Updating…';
                    }
                    if (form) {
                        const automatic = form.querySelector('input[name="automatic"]');
                        if (automatic) automatic.value = 'true';
                        form.requestSubmit();
                        return;
                    }
                }
            }

            if (liveStatus) liveStatus.textContent = 'Live · 30s';
        } catch {
            if (liveStatus) liveStatus.textContent = 'Live check unavailable';
        } finally {
            checking = false;
        }
    }

    document.querySelectorAll('.host-pool-rescan-form').forEach(form => {
        form.addEventListener('submit', () => {
            const button = form.querySelector('.host-pool-rescan-button');
            if (button) {
                button.disabled = true;
                button.textContent = 'Re-scanning…';
            }
        });
    });

    window.setInterval(checkHostPools, intervalMs);
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) checkHostPools();
    });
})();
</script>
