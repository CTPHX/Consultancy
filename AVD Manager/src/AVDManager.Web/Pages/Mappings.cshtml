@page
@model AVDManager.Web.Pages.MappingsModel
@{
    ViewData["Title"] = "Review mappings";
}

<div class="setup-shell">
    <div class="setup-intro">
        <span class="eyebrow">FIRST-TIME SETUP</span>
        <h1>Review environment mappings</h1>
        <p>Review the discovered host pools and choose the resource groups AVD Manager should use as deployment defaults. These choices do not move or change any Azure resources.</p>
    </div>

    <ol class="setup-steps">
        <li><strong>1</strong><div><b>Microsoft sign-in</b><span>Connected</span></div></li>
        <li><strong>2</strong><div><b>Select subscription</b><span>Selected</span></div></li>
        <li><strong>3</strong><div><b>Discover resources</b><span>Complete</span></div></li>
        <li class="active"><strong>4</strong><div><b>Review mappings</b><span>Confirm the environment configuration</span></div></li>
    </ol>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="setup-card"><h2>Mappings could not be built</h2><p>@Model.ErrorMessage</p></div>
    }
    else if (Model.Result is not null)
    {
        <div class="mapping-summary">
            <div><span>Subscription</span><strong>@Model.Result.Subscription.DisplayName</strong></div>
            <div><span>Host pools</span><strong>@Model.HostPools.Count</strong></div>
            <div><span>Resources scanned</span><strong>@Model.Result.Resources.Count</strong></div>
        </div>

        <div class="mapping-list">
            @foreach (var mapping in Model.HostPools)
            {
                <section class="mapping-card">
                    <div class="mapping-card-header">
                        <div><span class="mapping-label">HOST POOL</span><h2>@mapping.HostPool.Name</h2><p>@mapping.HostPool.ResourceGroup · @mapping.HostPool.Location</p></div>
                        <span class="confidence-badge">Discovered</span>
                    </div>

                    <h3 class="mapping-section-title">Deployment resource groups</h3>
                    <div class="rg-default-grid">
                        @foreach (var field in new[] {
                            ("AVD resources", "avd", mapping.Defaults.Avd),
                            ("Session host VMs", "sessionhosts", mapping.Defaults.SessionHosts),
                            ("Networking", "network", mapping.Defaults.Network),
                            ("Compute Gallery", "gallery", mapping.Defaults.Gallery),
                            ("FSLogix / Storage", "storage", mapping.Defaults.Storage),
                            ("Automation", "automation", mapping.Defaults.Automation),
                            ("Key Vault", "keyvault", mapping.Defaults.KeyVault)
                        })
                        {
                            <label class="rg-select-field">
                                <span>@field.Item1</span>
                                <select name="@($"{mapping.HostPool.Name}-{field.Item2}")">
                                    <option value="">Not selected</option>
                                    @foreach (var rg in Model.ResourceGroups)
                                    {
                                        if (string.Equals(rg, field.Item3, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@rg" selected>@rg</option>
                                        }
                                        else
                                        {
                                            <option value="@rg">@rg</option>
                                        }
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <p class="mapping-note">Suggested values come from discovered Azure relationships where available, then fall back to discovered resource locations. You can change them before the environment is saved.</p>

                    <h3 class="mapping-section-title">AVD relationships</h3>
                    <div class="mapping-grid">
                        <div class="mapping-field">
                            <label>Application groups linked by Azure</label>
                            @if (mapping.ApplicationGroups.Count == 0)
                            {
                                <span class="mapping-empty">No application groups linked to this host pool</span>
                            }
                            else
                            {
                                @foreach (var appGroup in mapping.ApplicationGroups)
                                {
                                    <span class="mapping-value"><strong>@appGroup.Name</strong>@if (!string.IsNullOrWhiteSpace(appGroup.ApplicationGroupType)){<small> · @appGroup.ApplicationGroupType</small>}</span>
                                }
                            }
                        </div>
                        <div class="mapping-field">
                            <label>Session host VMs linked by Azure</label>
                            @if (mapping.SessionHosts.Count == 0)
                            {
                                <span class="mapping-empty">No registered session hosts reported by this host pool</span>
                            }
                            else
                            {
                                @foreach (var sessionHost in mapping.SessionHosts)
                                {
                                    <span class="mapping-value">
                                        <strong>@sessionHost.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(sessionHost.Status)){<small> · @sessionHost.Status</small>}
                                        @if (sessionHost.Sessions.HasValue){<small> · @sessionHost.Sessions session(s)</small>}
                                        @if (sessionHost.AllowNewSession.HasValue){<small> · @(sessionHost.AllowNewSession.Value ? "Accepting sessions" : "Drain mode")</small>}
                                        @if (sessionHost.VirtualMachine is not null){<small> · VM: @sessionHost.VirtualMachine.Name · @sessionHost.VirtualMachine.ResourceGroup</small>}
                                        else{<small> · Backing VM not matched in subscription scan</small>}
                                    </span>
                                }
                            }
                        </div>
                    </div>
                    <p class="mapping-note">Application groups use AVD's hostPoolArmPath. Session hosts are read from each host pool's Azure Virtual Desktop sessionHosts collection and matched to their backing Azure VM.</p>
                </section>
            }
        </div>

        <div class="setup-actions">
            <a class="secondary-button link-button" href="/Discovery?subscriptionId=@Model.Result.Subscription.SubscriptionId">Back to discovery</a>
            <button class="primary-button" disabled title="Persistent environment storage is not enabled yet">Save environment</button>
        </div>
    }
</div>
