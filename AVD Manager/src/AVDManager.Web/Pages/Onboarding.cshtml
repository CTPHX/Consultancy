@page
@{
    ViewData["Title"] = "First-time setup";
}

<div class="setup-shell">
    <div class="setup-intro"><span class="eyebrow">FIRST-TIME SETUP</span><h1>Connect your Azure environment</h1><p>AVD Manager will discover your subscriptions and supported AVD resources. You can review and change every suggested mapping before anything is saved.</p></div>
    <ol class="setup-steps">
        <li class="active"><strong>1</strong><div><b>Microsoft sign-in</b><span>Authenticate with Entra ID</span></div></li>
        <li><strong>2</strong><div><b>Select subscription</b><span>Choose the Azure subscription to scan</span></div></li>
        <li><strong>3</strong><div><b>Discover resources</b><span>Find host pools, images, storage and automation</span></div></li>
        <li><strong>4</strong><div><b>Review mappings</b><span>Confirm the environment configuration</span></div></li>
    </ol>
    <div class="setup-card">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <h2>Microsoft account connected</h2>
            <p>Signed in as <strong>@User.Identity.Name</strong>. AVD Manager can now request read access to the Azure resources your account can access.</p>
            <a class="primary-button link-button" href="/Subscriptions">Continue to subscriptions</a>
        }
        else
        {
            <h2>Sign in to Microsoft Azure</h2>
            <p>No passwords, storage keys or domain credentials are stored by AVD Manager.</p>
            <a class="primary-button link-button" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn" asp-route-redirectUri="/Onboarding">Sign in with Microsoft</a>
        }
    </div>
</div>
