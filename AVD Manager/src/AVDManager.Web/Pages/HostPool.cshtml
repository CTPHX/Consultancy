@page "/HostPools/{id}"
@model AVDManager.Web.Pages.HostPoolModel
@{
    ViewData["Title"] = Model.HostPool?.HostPoolName ?? "Host Pool";
    var pool = Model.HostPool!;
    var hosts = pool.SessionHosts;
    var available = hosts.Count(h => string.Equals(h.Status, "Available", StringComparison.OrdinalIgnoreCase));
    var sessions = hosts.Sum(h => h.Sessions ?? 0);
    var scalingPlan = Model.ScalingPlans.FirstOrDefault();
}

<div class="page-heading">
    <div>
        <a href="/SessionHosts" class="muted" style="text-decoration:none;">← Host Pools</a>
        <div style="display:flex; align-items:center; gap:10px; margin-top:10px; flex-wrap:wrap;">
            <h1 style="margin:0;">@pool.HostPoolName</h1>
        </div>
        <p>@Model.EnvironmentConfiguration!.SubscriptionName · @pool.Location · Azure Virtual Desktop host pool</p>
    </div>
    <form method="post" asp-page-handler="Rescan">
        <input type="hidden" name="id" value="@pool.HostPoolName" />
        <button class="secondary-button" type="submit">Re-scan host pool</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-message status-bad" style="margin-bottom:16px;">@Model.ErrorMessage</div>
}

<section class="metrics session-host-metrics" style="grid-template-columns:repeat(5,minmax(0,1fr));">
    <article class="metric"><span>Session Hosts</span><strong>@hosts.Count</strong><small>Registered</small></article>
    <article class="metric"><span>Available</span><strong>@available</strong><small>@(hosts.Count - available) unavailable</small></article>
    <article class="metric"><span>Active Sessions</span><strong>@sessions</strong><small>Across this host pool</small></article>
    <article class="metric"><span>Application Groups</span><strong>@pool.ApplicationGroups.Count</strong><small>Linked by Azure</small></article>
    <article class="metric" style="padding-top:14px; padding-bottom:14px;">
        <span>Scaling Plan</span>
        @if (scalingPlan is not null)
        {
            <strong style="font-size:.95rem; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@scalingPlan.Name</strong>
            @if (scalingPlan.Enabled == true)
            {
                <small><span class="status-pill status-good">Enabled</span></small>
            }
            else if (scalingPlan.Enabled == false)
            {
                <small><span class="status-pill status-neutral">Disabled</span></small>
            }
            else
            {
                <small><span class="status-pill status-neutral">State unavailable</span></small>
            }
        }
        else if (!string.IsNullOrWhiteSpace(Model.ScalingPlanError))
        {
            <strong style="font-size:.95rem;">Unable to read</strong><small>Azure state unavailable</small>
        }
        else
        {
            <strong style="font-size:.95rem;">Not assigned</strong><small>No scaling plan</small>
        }
    </article>
</section>

<section class="panel" style="margin-top:16px;">
    <div class="panel-heading-row">
        <div><h2>Session hosts</h2><p class="muted">Select one or more hosts, then change drain mode or VM power state for the selection.</p></div>
        <small class="last-scan">Last scanned @((pool.LastScannedAtUtc ?? Model.EnvironmentConfiguration.LastScannedAtUtc).ToLocalTime().ToString("g"))</small>
    </div>

    @if (hosts.Count == 0)
    {
        <div class="empty-state"><strong>No registered session hosts</strong><p>Use Re-scan host pool after a host is registered in Azure Virtual Desktop.</p></div>
    }
    else
    {
        <form method="post" id="hostOperationsForm">
            <input type="hidden" name="id" value="@pool.HostPoolName" />
            <input type="hidden" name="allowNewSession" id="allowNewSession" value="false" />

            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:4px 0 14px;">
                <button class="secondary-button" type="submit" formaction="?handler=SetDrainMode" data-drain-action="false" disabled>Drain selected</button>
                <button class="secondary-button" type="submit" formaction="?handler=SetDrainMode" data-drain-action="true" disabled>Allow sessions</button>
                <button class="secondary-button" type="submit" formaction="?handler=StartHosts" data-host-action="start" disabled>Start selected</button>
                <button class="secondary-button" type="submit" formaction="?handler=StopHosts" data-host-action="stop" disabled>Stop selected</button>
                <span class="muted" id="selectionCount">0 selected</span>
            </div>

            <div class="session-host-table-wrap">
                <table class="session-host-table">
                    <thead>
                        <tr>
                            <th style="width:42px;"><input type="checkbox" id="selectAllHosts" aria-label="Select all session hosts" /></th>
                            <th>Session host</th><th>Status</th><th>Drain mode</th><th>Sessions</th><th>VM</th><th>Network</th><th>Image</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var host in hosts.OrderBy(h => h.Name))
                    {
                        var isAvailable = string.Equals(host.Status, "Available", StringComparison.OrdinalIgnoreCase);
                        var isDraining = host.AllowNewSession == false;
                        <tr>
                            <td><input class="host-selector" type="checkbox" name="selectedSessionHosts" value="@host.Name" aria-label="Select @host.Name" /></td>
                            <td><strong>@host.Name</strong></td>
                            <td><span class="status-pill @(isAvailable ? "status-good" : "status-bad")">@(host.Status ?? "Unknown")</span></td>
                            <td><span class="status-pill @(isDraining ? "status-warn" : "status-neutral")">@(isDraining ? "On" : "Off")</span></td>
                            <td><strong>@(host.Sessions ?? 0)</strong></td>
                            <td><strong>@(host.VmName ?? "—")</strong><small>@(host.VmResourceGroup ?? "VM relationship unavailable")</small></td>
                            <td><strong>@(host.VnetName ?? "—")</strong><small>@(host.SubnetName ?? host.NicName ?? "Network relationship unavailable")</small></td>
                            <td><strong>@(host.ImageDefinition ?? "—")</strong><small>@(host.ImageVersion is null ? host.GalleryName ?? "Image relationship unavailable" : $"{host.ImageVersion} · {host.GalleryName}")</small></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>

<section class="panel" style="margin-top:16px;">
    <h2>Operational controls</h2>
    <p class="muted">Drain mode and VM start/stop now use Azure Resource Manager directly. Stop deallocates the backing Azure VM and is allowed only when the selected session host is already in drain mode. Deployment remains a separate Azure Automation workflow.</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;">
        <button class="secondary-button" disabled>Deploy hosts</button>
    </div>
</section>

<script>
(() => {
    const form = document.getElementById('hostOperationsForm');
    if (!form) return;

    const selectors = Array.from(form.querySelectorAll('.host-selector'));
    const selectAll = document.getElementById('selectAllHosts');
    const count = document.getElementById('selectionCount');
    const actionValue = document.getElementById('allowNewSession');
    const buttons = Array.from(form.querySelectorAll('[data-drain-action], [data-host-action]'));

    function updateSelection() {
        const selected = selectors.filter(item => item.checked).length;
        count.textContent = `${selected} selected`;
        buttons.forEach(button => button.disabled = selected === 0);
        selectAll.checked = selected > 0 && selected === selectors.length;
        selectAll.indeterminate = selected > 0 && selected < selectors.length;
    }

    selectors.forEach(selector => selector.addEventListener('change', updateSelection));
    selectAll.addEventListener('change', () => {
        selectors.forEach(selector => selector.checked = selectAll.checked);
        updateSelection();
    });

    form.querySelectorAll('[data-drain-action]').forEach(button => button.addEventListener('click', event => {
        const selected = selectors.filter(item => item.checked).length;
        const allow = button.dataset.drainAction === 'true';
        const action = allow ? 'allow new sessions on' : 'place into drain mode';
        if (!window.confirm(`${action.charAt(0).toUpperCase() + action.slice(1)} ${selected} selected session host(s)? Existing sessions will not be disconnected.`)) {
            event.preventDefault();
            return;
        }
        actionValue.value = allow ? 'true' : 'false';
    }));

    form.querySelectorAll('[data-host-action]').forEach(button => button.addEventListener('click', event => {
        const selected = selectors.filter(item => item.checked).length;
        const start = button.dataset.hostAction === 'start';
        const prompt = start
            ? `Start the backing Azure VM for ${selected} selected session host(s)?`
            : `Stop and deallocate the backing Azure VM for ${selected} selected session host(s)? Selected hosts must already be in drain mode.`;
        if (!window.confirm(prompt))
            event.preventDefault();
    }));

    updateSelection();
})();
</script>
