@page "/HostPools/{id}"
@model AVDManager.Web.Pages.HostPoolModel
@{
    ViewData["Title"] = Model.HostPool?.HostPoolName ?? "Host Pool";
    var pool = Model.HostPool!;
    var hosts = pool.SessionHosts;
    var available = hosts.Count(h => string.Equals(h.Status, "Available", StringComparison.OrdinalIgnoreCase));
    var sessions = hosts.Sum(h => h.Sessions ?? 0);
    var scalingPlan = Model.ScalingPlans.FirstOrDefault();
}

<div class="page-heading">
    <div>
        <a href="/SessionHosts" class="muted" style="text-decoration:none;">← Host Pools</a>
        <div style="display:flex; align-items:center; gap:10px; margin-top:10px; flex-wrap:wrap;">
            <h1 style="margin:0;">@pool.HostPoolName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <span class="status-pill status-good">@Model.StatusMessage</span>
            }
        </div>
        <p>@Model.EnvironmentConfiguration!.SubscriptionName · @pool.Location · Azure Virtual Desktop host pool</p>
    </div>
    <form method="post" asp-page-handler="Rescan">
        <input type="hidden" name="id" value="@pool.HostPoolName" />
        <button class="secondary-button" type="submit">Re-scan host pool</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-message status-bad" style="margin-bottom:16px;">@Model.ErrorMessage</div>
}

<section class="metrics session-host-metrics">
    <article class="metric"><span>Session Hosts</span><strong>@hosts.Count</strong><small>Registered</small></article>
    <article class="metric"><span>Available</span><strong>@available</strong><small>@(hosts.Count - available) unavailable</small></article>
    <article class="metric"><span>Active Sessions</span><strong>@sessions</strong><small>Across this host pool</small></article>
    <article class="metric"><span>Application Groups</span><strong>@pool.ApplicationGroups.Count</strong><small>Linked by Azure</small></article>
    <article class="metric">
        <span>Scaling Plan</span>
        @if (scalingPlan is not null)
        {
            <strong style="font-size:1rem; line-height:1.25;">@scalingPlan.Name</strong>
            @if (scalingPlan.Enabled == true)
            {
                <small><span class="status-pill status-good">Enabled</span></small>
            }
            else if (scalingPlan.Enabled == false)
            {
                <small><span class="status-pill status-neutral">Disabled</span></small>
            }
            else
            {
                <small><span class="status-pill status-neutral">State unavailable</span></small>
            }
        }
        else if (!string.IsNullOrWhiteSpace(Model.ScalingPlanError))
        {
            <strong style="font-size:1rem;">Unable to read</strong><small>Azure state unavailable</small>
        }
        else
        {
            <strong style="font-size:1rem;">Not assigned</strong><small>No scaling plan</small>
        }
    </article>
</section>

<section class="panel" style="margin-top:16px;">
    <div class="panel-heading-row">
        <div><h2>Session hosts</h2><p class="muted">Registered hosts in this Azure Virtual Desktop host pool.</p></div>
        <small class="last-scan">Last scanned @((pool.LastScannedAtUtc ?? Model.EnvironmentConfiguration.LastScannedAtUtc).ToLocalTime().ToString("g"))</small>
    </div>

    @if (hosts.Count == 0)
    {
        <div class="empty-state"><strong>No registered session hosts</strong><p>Use Re-scan host pool after a host is registered in Azure Virtual Desktop.</p></div>
    }
    else
    {
        <div class="session-host-table-wrap">
            <table class="session-host-table">
                <thead><tr><th>Session host</th><th>Status</th><th>Drain mode</th><th>Sessions</th><th>VM</th><th>Network</th><th>Image</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var host in hosts.OrderBy(h => h.Name))
                {
                    var isAvailable = string.Equals(host.Status, "Available", StringComparison.OrdinalIgnoreCase);
                    var isDraining = host.AllowNewSession == false;
                    <tr>
                        <td><strong>@host.Name</strong></td>
                        <td><span class="status-pill @(isAvailable ? "status-good" : "status-bad")">@(host.Status ?? "Unknown")</span></td>
                        <td><span class="status-pill @(isDraining ? "status-warn" : "status-neutral")">@(isDraining ? "On" : "Off")</span></td>
                        <td><strong>@(host.Sessions ?? 0)</strong></td>
                        <td><strong>@(host.VmName ?? "—")</strong><small>@(host.VmResourceGroup ?? "VM relationship unavailable")</small></td>
                        <td><strong>@(host.VnetName ?? "—")</strong><small>@(host.SubnetName ?? host.NicName ?? "Network relationship unavailable")</small></td>
                        <td><strong>@(host.ImageDefinition ?? "—")</strong><small>@(host.ImageVersion is null ? host.GalleryName ?? "Image relationship unavailable" : $"{host.ImageVersion} · {host.GalleryName}")</small></td>
                        <td>
                            <form method="post" asp-page-handler="SetDrainMode" onsubmit="return confirm('@(isDraining ? "Allow this session host to accept new sessions?" : "Place this session host into drain mode? Existing sessions will remain connected.")');">
                                <input type="hidden" name="id" value="@pool.HostPoolName" />
                                <input type="hidden" name="sessionHostName" value="@host.Name" />
                                <input type="hidden" name="allowNewSession" value="@(isDraining ? "true" : "false")" />
                                <button class="secondary-button" type="submit">@(isDraining ? "Allow sessions" : "Drain host")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" style="margin-top:16px;">
    <h2>Operational controls</h2>
    <p class="muted">Drain mode is now submitted through Azure Automation. Start, stop, restart and deployment controls will use the same controlled job pattern rather than direct browser-side Azure changes.</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;">
        <button class="secondary-button" disabled>Start hosts</button>
        <button class="secondary-button" disabled>Stop hosts</button>
        <button class="secondary-button" disabled>Deploy hosts</button>
    </div>
</section>
