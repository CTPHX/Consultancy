{
  "name": "AVD Manager (.NET 8)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0-bookworm",
  "workspaceFolder": "/workspaces/Consultancy",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "AVD Manager",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "dotnet restore \"AVD Manager/src/AVDManager.Web/AVDManager.Web.csproj\"",
  "postStartCommand": "nohup bash -c 'cd \"/workspaces/Consultancy/AVD Manager/src/AVDManager.Web\" && exec dotnet run --no-restore --urls http://0.0.0.0:5000' >/tmp/avd-manager.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp"
      ]
    }
  }
}
